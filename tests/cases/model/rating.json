        "input": { "rootPubkey": "@alice", "subject": { "type": "i", "value": "post:id:7" }, "context": "security:access" },
        "expectModel": { "degree": 0, "claimCount": 0 }
      },
      {
        "type": "rating",
        "input": { "rootPubkey": "@alice", "subject": { "type": "i", "value": "post:id:7" }, "context": "security" },
