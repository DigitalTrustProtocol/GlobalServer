        "input": { "rootPubkey": "@alice", "subject": { "type": "i", "value": "post:id:7" }, "labels": ["accurate"] },
        "expect": { "degree": 0, "claimCount": 0, "averageScore": null }
      }
    ]
  },
  {
    "id": "rating-own-and-zero-score",
    "tags": ["rating"],
    "records": [
      { "pubkey": "@alice", "kind": 32014, "subjectType": "i", "subject": "post:id:8", "value": 10, "scopeRank": 2 },
      { "pubkey": "@alice", "subject": "@b", "context": "identity", "value": 1 },
      { "pubkey": "@b", "kind": 32014, "subjectType": "i", "subject": "post:id:9", "value": 0, "scopeRank": 2 }
    ],
    "queries": [
      {
        "type": "rating",
        "input": { "rootPubkey": "@alice", "subject": { "type": "i", "value": "post:id:8" } },
        "expect": { "degree": 1, "claimCount": 1, "averageScore": 10, "own": { "author": "@alice", "score": 10, "distance": 0 } }
      },
      {
        "type": "rating",
        "input": { "rootPubkey": "@alice", "subject": { "type": "i", "value": "post:id:9" } },
        "expect": { "degree": 2, "claimCount": 1, "averageScore": 0 }
      }
    ]
