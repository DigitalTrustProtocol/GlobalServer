      },
      {
        "type": "trust",
        "input": { "rootPubkey": "@alice", "subject": { "type": "p", "value": "@d" }, "context": "identity", "maxReachedNodes": 4 },
        "expect": { "connected": true, "degree": 3, "truncated": false }
