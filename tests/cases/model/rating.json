[
  {
    "id": "rating-nearest-degree-mean",
    "tags": ["rating"],
    "records": [
      { "pubkey": "@alice", "subject": "@b", "context": "identity", "value": 1 },
      { "pubkey": "@alice", "subject": "@c", "context": "identity", "value": 1 },
      { "id": "@r-b", "pubkey": "@b", "kind": 32014, "subjectType": "i", "subject": "post:id:7", "value": 80, "scopeRank": 2, "labels": ["accurate"], "content": "solid" },
      { "id": "@r-c", "pubkey": "@c", "kind": 32014, "subjectType": "i", "subject": "post:id:7", "value": 45.5, "scopeRank": 2 },
      { "pubkey": "@b", "subject": "@d", "context": "identity", "value": 1 },
      { "pubkey": "@d", "kind": 32014, "subjectType": "i", "subject": "post:id:7", "value": 5, "scopeRank": 2 }
    ],
    "queries": [
      {
        "type": "rating",
        "input": { "rootPubkey": "@alice", "subject": { "type": "i", "value": "post:id:7" } },
        "expect": { "degree": 2, "claimCount": 2, "averageScore": 62.75,
                    "claims": [
                      { "author": "@c", "score": 45.5, "distance": 1, "labels": [], "content": "" },
                      { "author": "@b", "score": 80, "distance": 1, "labels": ["accurate"], "content": "solid" }
                    ] }
      },
      {
        "type": "rating",
        "input": { "rootPubkey": "@alice", "subject": { "type": "i", "value": "post:id:7" }, "labels": ["accurate"] },
        "expect": { "degree": 2, "claimCount": 1, "averageScore": 80 }
      },
      {
        "type": "rating",
        "input": { "rootPubkey": "@alice", "subject": { "type": "i", "value": "post:id:7" }, "labels": ["nope"] },
        "expect": { "degree": 0, "claimCount": 0, "averageScore": null, "claims": [], "sourceEventIds": [] }
      },
      {
        "type": "rating",
        "input": { "rootPubkey": "@alice", "subject": { "type": "i", "value": "post:id:7" }, "format": "path" },
        "expect": { "degree": 2, "ratingEdges": [{ "eventId": "@r-c", "value": -1, "depth": 2, "from": "p:@c", "to": "i:post:id:7" }, { "eventId": "@r-b", "value": 1, "depth": 2, "from": "p:@b" }],
                    "pathView": { "nodes": [
                      { "subject": { "type": "i", "value": "post:id:7" }, "depth": 2, "kind": "post" },
                      { "subject": { "type": "p", "value": "@c" }, "depth": 1 },
                      { "subject": { "type": "p", "value": "@b" }, "depth": 1 },
                      { "subject": { "type": "p", "value": "@alice" }, "depth": 0 }
                    ] } }
      }
    ]
  },
  {
    "id": "rating-label-filter-does-not-continue",
