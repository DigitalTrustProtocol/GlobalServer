[
  {
    "id": "walk-direct-and-two-hop",
    "tags": ["walk"],
    "records": [
      { "pubkey": "@alice", "subject": "@bob", "context": "identity", "value": 1 },
      { "pubkey": "@bob", "subject": "@carol", "context": "identity", "value": 1, "content": "met in person", "labels": ["friend"] }
    ],
    "queries": [
      {
        "type": "trust",
        "input": { "rootPubkey": "@alice", "subject": { "type": "p", "value": "@bob" }, "context": "identity" },
        "expect": { "connected": true, "degree": 1, "trust": 1, "distrust": 0, "trustValue": 1, "resolution": "trusted",
                    "direct": { "author": "@alice", "distance": 0 },
                    "statements": [{ "author": "@alice", "value": 1, "distance": 0, "contextMatch": "exact", "requestedContext": "identity" }] }
      },
      {
        "type": "trust",
        "input": { "rootPubkey": "@alice", "subject": { "type": "p", "value": "@carol" }, "context": "identity" },
        "expect": { "connected": true, "degree": 2, "trust": 1, "resolution": "trusted",
                    "statements": [{ "author": "@bob", "distance": 1, "content": "met in person", "labels": ["friend"] }] }
      },
      {
        "type": "trust",
        "input": { "rootPubkey": "@alice", "subject": { "type": "p", "value": "@nobody" }, "context": "identity" },
        "expect": { "connected": false, "degree": 0, "resolution": "none", "statements": [], "sourceEventIds": [] }
      }
    ]
  },
