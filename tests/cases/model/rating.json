      { "pubkey": "@a1", "subject": "@d", "context": "identity", "value": 1 },
      { "pubkey": "@a2", "subject": "@d", "context": "identity", "value": -1 },
      { "pubkey": "@a3", "subject": "@d", "context": "identity", "value": -1 },
      { "pubkey": "@d", "kind": 32014, "subjectType": "i", "subject": "post:id:5", "value": 70, "scopeRank": 2 },
      { "pubkey": "@d", "subject": "@e", "context": "identity", "value": 1 }
    ],
    "queries": [
      {
