      { "pubkey": "@b", "subject": "@d", "context": "identity", "value": 1 },
      { "pubkey": "@d", "kind": 32014, "subjectType": "i", "subject": "post:id:7", "value": 60, "scopeRank": 2, "labels": ["accurate"] }
